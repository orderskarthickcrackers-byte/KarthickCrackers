{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER_HOST;Database=KarthickCrackersDb;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "SuperSecretKeyForKarthickCrackersApp123456!",
    "Issuer": "KarthickCrackers.Api",
    "Audience": "KarthickCrackers.Client",
    "ExpirationInMinutes": 480
  },
  "AppConfig": {
    "ApplicationName": "Karthick Crackers API",
    "Version": "1.0.0"
  },
  "MetaWhatsAppConfig": {
    "Enabled": true,
    "ApiVersion": "v19.0",
    "PhoneNumberId": "YOUR_META_PHONE_NUMBER_ID",
    "BusinessAccountId": "YOUR_META_BUSINESS_ACCOUNT_ID",
    "AccessToken": "YOUR_META_PERMANENT_OR_SANDBOX_ACCESS_TOKEN",
    "TemplateName": "order_confirmation",
    "LanguageCode": "en_US",
    "AdminPhoneNumber": "916380891094"
  },
  "SmtpSettings": {
    "Enabled": true,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderName": "Karthick Crackers Orders",
    "SenderEmail": "orders.karthick.crackers@gmail.com",
    "AdminEmail": "orders.karthick.crackers@gmail.com",
    "Username": "orders.karthick.crackers@gmail.com",
    "Password": "YOUR_16_CHAR_GMAIL_APP_PASSWORD"
  }
}
